meta {
  name: Move project images
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/projects/{{projectId}}/images/collection
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "imageIds": [
      "{{imageId}}"
    ],
    "collectionId": "{{collectionId}}"
  }
}
