meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "ali@example.com",
    "password": "secret123"
  }
}

script:post-response {
  if (res.body.data) {
    bru.setEnvVar("accessToken", res.body.data.accessToken);
  }
}
