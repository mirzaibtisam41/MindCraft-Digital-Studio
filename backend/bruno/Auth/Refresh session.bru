meta {
  name: Refresh session
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.data.accessToken);
  }
}

docs {
  Uses the mds_refresh httpOnly cookie (Bruno keeps cookies automatically). Rotates the refresh token and returns a new access token.
}
