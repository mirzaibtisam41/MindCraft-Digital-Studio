meta {
  name: Forgot password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

docs {
  With MAIL_PROVIDER=console the reset link is printed in the backend terminal. Copy its token into the resetToken environment variable.
}
