meta {
  name: Update image model
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/admin/models/gpt-image-1-mini
  body: json
  auth: inherit
}

body:json {
  {
    "label": "GPT Image 1 Mini",
    "enabled": true,
    "sortOrder": 0,
    "creditsPerImage": {
      "low": 1,
      "medium": 2,
      "high": 4
    },
    "capabilities": {
      "maxImagesPerRequest": 10,
      "defaults": {
        "quality": "medium"
      }
    }
  }
}

docs {
  Send only the fields you want to change. The last enabled model cannot be disabled. Features (seed, negativePrompt, ...) are owned by the provider adapter and cannot be edited.
}
