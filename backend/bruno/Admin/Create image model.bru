meta {
  name: Create image model
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/admin/models
  body: json
  auth: inherit
}

body:json {
  {
    "id": "gpt-image-1.5",
    "provider": "openai",
    "label": "GPT Image 1.5",
    "enabled": true,
    "creditsPerImage": {
      "low": 2,
      "medium": 5,
      "high": 10
    }
  }
}

docs {
  The id must match the provider's model id exactly. capabilities is optional and starts from the standard image options. Features are owned by the provider adapter.
}
